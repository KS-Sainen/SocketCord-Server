# Copy to .env (same folder as docker-compose.yml) and change the secrets.
# docker-compose.yml forwards every setting below to the backend.

# Any characters are fine (it is passed as PGPASSWORD, not inside a URL).
POSTGRES_PASSWORD=change-me
# Port published on the host; clients connect here.
SOCKETCORD_PORT=8080

# One new account per device/address per day. Set to false while developing.
REG_LIMIT_ENABLED=true
# Accounts per device id per day, and per source IP per day (0 turns a rule off).
# Behind NAT (Docker on a Mac, campus networks) many clients share one IP.
REG_LIMIT_DEVICE_MAX=1
REG_LIMIT_IP_MAX=20

# false (the default): the first DM opens the DM room at once.
# true: the first DM is a request the receiver must accept before the room opens
# (GET users/requests, event/request; docs/API.md section 2.9).
DM_REQUIRE_ACCEPT=false

# AI chat summaries (rubric Part 3). Paste an API key from https://console.anthropic.com
# (Settings > API keys). Leave it empty and the server answers with an offline
# summary that is not written by AI. When a member asks for a summary, the text
# of those messages, with the senders' usernames, is sent to Anthropic's API.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5     # claude-sonnet-5-5 or claude-haiku-5-5 cost less
# AI_DAILY_LIMIT=100           # paid summaries per UTC day, whole server (0 = no cap)
# AI_SUMMARY_PER_MINUTE=4      # per account
# AI_PROVIDER=auto             # auto | claude | offline | off

# Optional tuning (defaults shown):
# SESSION_TTL_HOURS=168
# LOGIN_MAX_FAILURES=5
# LOGIN_FAILURE_WINDOW_SECONDS=300
# LOGIN_MAX_FAILURES_PER_CLIENT=50
# REGISTER_RATE_PER_MINUTE=120
# REGISTER_BURST=40
# GROUP_CREATE_PER_HOUR=20
# REQUEST_RATE_PER_HOUR=120
# MAX_PENDING_REQUESTS=100
# REG_LIMIT_WINDOW_HOURS=24
# REG_LIMIT_EXEMPT=
# SOCKETCORD_WORKERS=16
LOG_LEVEL=INFO
